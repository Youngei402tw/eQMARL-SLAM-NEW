#!/bin/bash
#PBS -N eqmarl-slam
#PBS -l select=1:ncpus=8:mem=32gb:ngpus=1
#PBS -l walltime=64:00:00
#PBS -j oe
#PBS -o eqmarl-slam.o${PBS_JOBID}

# =============================================================================
# One-framework, one-seed active-SLAM training for eQMARL on Vanda
#
# Submit all four separate jobs: bash scripts/submit_vanda_four.sh
# Submit one job manually: qsub -v SLAM_FRAMEWORK=fctde train_vanda.pbs
# Monitor: qstat -u $USER       Cancel: qdel <PBS_JOBID>
# =============================================================================

set -euo pipefail

cd "$PBS_O_WORKDIR"
echo "Working directory: $(pwd)"
echo "Job ID: $PBS_JOBID"
echo "Node: $(hostname)"
echo "Start time: $(date)"
echo ""

# ---------------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------------
SLAM_MODE="${SLAM_MODE:-fast}"
SLAM_FRAMEWORK="${SLAM_FRAMEWORK:-}"

if [[ "$SLAM_MODE" != "fast" && "$SLAM_MODE" != "full" ]]; then
    echo "SLAM_MODE must be fast or full, got: $SLAM_MODE" >&2
    exit 2
fi
case "$SLAM_FRAMEWORK" in
    eqmarl_psi+|qfctde|fctde|sctde) ;;
    *)
        echo "Set SLAM_FRAMEWORK to eqmarl_psi+, qfctde, fctde, or sctde." >&2
        exit 2
        ;;
esac
if [[ "$SLAM_MODE" == "fast" ]]; then
    SLAM_N_EPISODES="${SLAM_N_EPISODES:-50}"
    SLAM_MAX_STEPS="${SLAM_MAX_STEPS:-50}"
else
    SLAM_N_EPISODES="${SLAM_N_EPISODES:-2000}"
    SLAM_MAX_STEPS="${SLAM_MAX_STEPS:-250}"
fi

echo "Mode: $SLAM_MODE"
echo "Framework: $SLAM_FRAMEWORK | Seeds: 1"
echo "Episodes: $SLAM_N_EPISODES | Steps: $SLAM_MAX_STEPS"
echo ""

# ---------------------------------------------------------------------------
# Activate Conda environment
# ---------------------------------------------------------------------------
module load Miniconda3
source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate eQMARL_SLAM
export LD_LIBRARY_PATH="$CONDA_PREFIX/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export PYTHONPATH="$PWD${PYTHONPATH:+:$PYTHONPATH}"
echo "Conda env: $CONDA_DEFAULT_ENV"
echo "Python: $(python --version)"
python -c "import cirq, gymnasium, tensorflow_quantum"
echo ""

# ---------------------------------------------------------------------------
# GPU information
# ---------------------------------------------------------------------------
echo "--- GPU Info ---"
nvidia-smi
echo ""

# ---------------------------------------------------------------------------
# Run active-SLAM training
# ---------------------------------------------------------------------------
config="experiments/active_slam_maa2c_${SLAM_FRAMEWORK}.yml"
args=("$config" -r 1 --n-episodes "$SLAM_N_EPISODES"
    --max-steps-per-episode "$SLAM_MAX_STEPS")
if [[ "$SLAM_MODE" == "fast" ]]; then
    args+=(--fast)
fi
echo "==========================================="
echo "Starting $SLAM_FRAMEWORK with $config"
echo "==========================================="
python scripts/experiment_runner.py "${args[@]}" 2>&1 | tee "training-${SLAM_FRAMEWORK}-${PBS_JOBID}.log"

# ---------------------------------------------------------------------------
# Summary
# ---------------------------------------------------------------------------
echo ""
echo "==========================================="
echo "Training complete!"
echo "End time: $(date)"
echo "Results saved under: experiment_output/active_slam_maa2c_${SLAM_FRAMEWORK}/"
echo "==========================================="
